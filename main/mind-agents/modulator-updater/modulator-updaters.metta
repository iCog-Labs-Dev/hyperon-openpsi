(: ActivationHelper (-> Number Number Number))
(= (ActivationHelper $competence $energy)
    (* (/ $competence (+ $competence 0.5) )
        (/ $energy (+ 0.05 $energy) )
    )
         
)
(: SecuringThresholdHelper (-> Number Number Number))
(= (SecuringThresholdHelper  $integrity $certanity)
    (*  (/ $certanity (+ $certanity 0.05))
        (pow-math $integrity 3) 
    )
)

(: SelectionThresholdHelper (-> Number Number))
(= (SelectionThresholdHelper $competence)
    (fuzzy_equal $competence 1 15)   
)

(= (modulatorUpdaterAgent $modulatorSpace $competence-demand $affiliation-demand $energy-demand)
  (let* (
        ($certanity 0.5)
        ($integrity 0.5)
        ((demand competence $minComp $maxComp $competenceValue) $competence-demand)
        ((demand affiliation $minAff $maxAff $affiliationValue) $affiliation-demand)
        ((demand energy $minEne $maxEne $energyValue) $energy-demand)
        ($activationValue (ActivationHelper $competenceValue $energyValue))
        ($activationValue' (normalizeWithSpecificRange $activationValue 0.0 1.0))
        ($securingValue (SecuringThresholdHelper $integrity $certanity))
        ($securingValue' (normalizeWithSpecificRange $securingValue 0.0 1.0))
        ($selectionValue (SelectionThresholdHelper $competenceValue))
        ($selectionValue' (normalizeWithSpecificRange $selectionValue 0.0 1.0))
        ($activationModulator (fetch-modulator $modulatorSpace arousal))
        ($securingModulator (fetch-modulator $modulatorSpace securing-threshold))
        ($selectionModulator (fetch-modulator $modulatorSpace selection-threshold))
        ($_ (update-atom $modulatorSpace $activationModulator (modulator arousal $activationValue')))
        ($_ (update-atom $modulatorSpace $securingModulator (modulator securing-threshold $securingValue')))
        ($_ (update-atom $modulatorSpace $selectionModulator (modulator selection-threshold $selectionValue')))
  
   )
    ()


  )
)