!(register-module! ../../../hyperon-openpsi)
!(register-module! ../../utilities-module)

!(import! &self utilities-module:utils)
!(import! &self hyperon-openpsi:main:modulator:modulator)
!(import! &self hyperon-openpsi:main:demand:demand)
!(import! &self hyperon-openpsi:main:mind-agents:feeling-updater:feeling-updaters)
!(import! &self hyperon-openpsi:main:mind-agents:modulator-updater:modulator-updaters)
!(import! &self hyperon-openpsi:main:mind-agents:action-planner:action-planner-v1)
!(import! &self hyperon-openpsi:main:feed-back-loop:feed-back-loop)
!(import! &self hyperon-openpsi:use-cases:qwestor:setup_kb)
!(import! &self hyperon-openpsi:psi-utilities:psi_utils)
!(import! &self hyperon-openpsi:psi-utilities:normalization)
!(import! &self hyperon-openpsi:use-cases:qwestor:out)
!(import! &self hyperon-openpsi:use-cases:qwestor:in)
!(import! &self hyperon-openpsi:use-cases:qwestor:fetch-modulators)
!(import! &self hyperon-openpsi:use-cases:qwestor:fetch-demands)


(= (fetchContext) (match &self (INPUT_CONTEXT $ctx) $ctx))

(= (populateDemands $demandSpace)
    (let $demands (fetchDemandsFromDb) 
      (if (== $demands ()) 
        (populateDemandSpace $demandSpace)
        (add-reduct $demandSpace (superpose $demands))
        )
      )
)

(= (addModulators $modulatorSpace)
    (let $modulators (fetchModulatorsFromDb) 
      (if (== $modulators ()) 
        (insert-modulators $modulatorSpace)
        (add-reduct $modulatorSpace (superpose $modulators))
        )
      )
)

(: kb-initializer (-> Grounded Expression))
(= (kb-initializer $kb)
   (let* 
     (
      ($rules (collapse (get-atoms &ruleSpace)))
      ($modulators (collapse (get-atoms &modulator-space)))
      ($demands (collapse (get-atoms &demandspace)))
      ($partialKb (union-atom $rules $modulators))
      ($kbExp (union-atom $partialKb $demands))
      ($_ (collapse (add-atoms $kb $kbExp)))
    )
    ()
	)
)

(= (qwestorLoop $contextState $kb)
   (let* (
    ($demands (queryAll $kb demand))  
		($currDemand (demandSelector $demands))
    ((demand $demandName $demandVal) $currDemand)
    ($goalObj (goal-selector $kb $demandName))
		((Goal $goal $goalVal1 $goalVal2) $goalObj) 
    ; ($_ (println! (goalObj $goalObj)))
		($actions (planner &ruleSpace $contextState $goal))
    ; ($_ (println! (aa args $goalObj $currDemand)))
		($applyValue (applyActions $actions $goalObj $currDemand)) 
		($competenceDemand (getDemandByName &demandspace competence)) 
		($affiliationDemand (getDemandByName &demandspace affiliation))
		($energyDemand (getDemandByName &demandspace energy))
    ; ($_ (println! ($competenceDemand $affiliationDemand $energyDemand)))
    ($modUpdate (modulatorUpdaterAgent &modulator-space $competenceDemand $affiliationDemand $energyDemand))
    ($_ (println! ((demands ($affiliationDemand $competenceDemand $energyDemand)))))
    ($_ (println! ((modulators (collapse (get-atoms &modulator-space))))))
   )
    $actions
   ) 
)

!(addDemandGoalRels &kb)
!(populateRuleSpace &ruleSpace)
!(populateDemands &demandspace)
!(addModulators &modulator-space)
!(kb-initializer &kb)
!(qwestorLoop (fetchContext) &kb)

